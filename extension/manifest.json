{
  "manifest_version": 3,
  "name": "B站直播间监控录屏助手",
  "version": "1.1.0",
  "description": "监控B站直播间开播状态，自动提醒并录制直播内容。支持多主播监控、自动录屏、开播提醒。",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting",
    "downloads",
    "alarms",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.live.bilibili.com/*",
    "https://live.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站直播间监控助手"
  },
  "content_scripts": [
    {
      "matches": ["https://live.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
